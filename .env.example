# Database
# Get your DATABASE_URL from Railway or any PostgreSQL provider
# Example: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/radiantclaims"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-in-production"
# NEXTAUTH_URL is optional in development - NextAuth auto-detects it
# Only required for production deployments
# NEXTAUTH_URL="https://your-production-domain.com"

# Cloudflare R2 / S3-compatible storage (optional, for file uploads)
# Leave empty to use mock upload (for development)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="" # e.g., https://account-id.r2.cloudflarestorage.com
R2_BUCKET="" # e.g., radiantclaims-uploads

# Resend (optional, for email notifications)
# Get your API key from https://resend.com
RESEND_API_KEY=""

# Upstash Redis (optional, for rate limiting in production)
# Get your credentials from https://upstash.com
# Uses in-memory fallback in development if not set
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe Payment Processing
# Get your keys from https://dashboard.stripe.com/apikeys
# IMPORTANT: Use test keys in development (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY="" # Secret key (sk_test_... for testing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # Publishable key (pk_test_... for testing)

# Stripe Product/Price IDs
# Create these in Stripe Dashboard after setting up products
# Setup Fee: One-time $149.99 charge
STRIPE_PRICE_ID_DIY_SETUP="" # Example: price_1ABC123...

# Monthly Subscription: Recurring $24.99/month
STRIPE_PRICE_ID_DIY_MONTHLY="" # Example: price_1XYZ789...

# Stripe Webhook Secret
# Get this after setting up webhook endpoint in Stripe Dashboard
# Webhook URL should be: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="" # Example: whsec_...

# Development only - skip env validation
# SKIP_ENV_VALIDATION=true
