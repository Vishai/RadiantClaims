# Database
# Get your DATABASE_URL from Railway or any PostgreSQL provider
# Example: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/radiantclaims"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-in-production"
# NEXTAUTH_URL is optional in development - NextAuth auto-detects it
# Only required for production deployments
# NEXTAUTH_URL="https://your-production-domain.com"

# Cloudflare R2 / S3-compatible storage (optional, for file uploads)
# Leave empty to use mock upload (for development)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="" # e.g., https://account-id.r2.cloudflarestorage.com
R2_BUCKET="" # e.g., radiantclaims-uploads

# Resend (optional, for email notifications)
# Get your API key from https://resend.com
RESEND_API_KEY=""

# Upstash Redis (optional, for rate limiting in production)
# Get your credentials from https://upstash.com
# Uses in-memory fallback in development if not set
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe Payment Processing
# Get your keys from https://dashboard.stripe.com/apikeys
# IMPORTANT: Use test keys in development (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY="" # Secret key (sk_test_... for testing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # Publishable key (pk_test_... for testing)

# Stripe Product/Price IDs
# Create these in Stripe Dashboard after setting up products
# Setup Fee: One-time $149.99 charge
STRIPE_PRICE_ID_DIY_SETUP="" # Example: price_1ABC123...

# Monthly Subscription: Recurring $24.99/month
STRIPE_PRICE_ID_DIY_MONTHLY="" # Example: price_1XYZ789...

# Stripe Webhook Secret
# Get this after setting up webhook endpoint in Stripe Dashboard
# Webhook URL should be: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="" # Example: whsec_...

# OpenAI API (for AI validation, GPT-4o Vision OCR, and Contact Agent)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Contact Agent Web Search (optional)
# Tavily API - Web search optimized for AI agents (recommended)
# Get your API key from https://tavily.com
# Only needed if you want web search fallback when database has no contacts
# Cost: ~$1/1000 searches
TAVILY_API_KEY=""

# Alternative: Serper API - Google Search API
# Get your API key from https://serper.dev
# More expensive but provides Google search results
# Cost: ~$10/1000 searches
# SERPER_API_KEY=""

# OCR Configuration
# Enable/disable individual OCR tiers (all enabled by default)
OCR_ENABLE_TIER_1=true  # PDF.js/pdf-parse (free)
OCR_ENABLE_TIER_2=true  # AWS Textract ($1.50/1K pages)
OCR_ENABLE_TIER_3=true  # Google Vision ($1.50/1K pages)
OCR_ENABLE_TIER_4=false  # GPT-4o Vision (~$0.025/doc)

# OCR Thresholds
OCR_MIN_CHARS_THRESHOLD=50  # Minimum characters to consider success

# AWS Textract (Tier 2 OCR)
# Get credentials from AWS Console: https://console.aws.amazon.com/iam/
# Create IAM user with Textract permissions
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Google Cloud Vision (Tier 3 OCR)
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
# Create service account with Vision API access
GOOGLE_CLOUD_PROJECT_ID=""
# Option 1: Path to service account JSON file
GOOGLE_CLOUD_CREDENTIALS=""
# Option 2: Base64-encoded service account JSON (better for Vercel/serverless)
# Generate with: base64 -i service-account-key.json | tr -d '\n'
GOOGLE_CLOUD_CREDENTIALS_BASE64=""

# Registration Control
# Set to false to block new user registrations (useful during onboarding/maintenance)
REGISTRATION_ENABLED=true

# Development only - skip env validation
# SKIP_ENV_VALIDATION=true
