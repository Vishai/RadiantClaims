{
  "manifest_version": 3,
  "name": "RadiantClaims – DOJ Portal Helper",
  "version": "0.1.0",
  "description": "Helps you transfer your RadiantClaims data into the DOJ RECA portal. Not affiliated with the U.S. Department of Justice.",
  "permissions": ["storage", "activeTab", "cookies"],
  "host_permissions": [
    "https://reca.justice.gov/*",
    "https://www.radiantclaims.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://reca.justice.gov/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
