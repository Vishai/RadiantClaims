// Store AI agent validation results for each document
model DocumentValidation {
  id String @id @default(cuid())

  // Relations
  uploadedFileId String       @unique
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  // Agent Results (stored as JSON)
  classifierResult Json? // From Classifier Agent
  identityResult   Json? // From Identity Verification Agent
  medicalResult    Json? // From Medical Compliance Agent
  residenceResult  Json? // From Residence Proof Agent
  employmentResult Json? // From Employment Verification Agent
  extractedData    Json? // From Data Extraction Agent

  // Overall Status
  status            ValidationStatus @default(PENDING)
  overallConfidence Float? // 0-1

  // Issues and Suggestions
  criticalIssues Json[] // Array of critical blocking issues
  warnings       Json[] // Array of warnings that need review
  suggestions    Json[] // Array of actionable suggestions

  // Processing Metadata
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingTimeMs      Int?

  // Staff Review
  reviewedBy    String? // Staff user ID who reviewed
  reviewedAt    DateTime?
  staffOverride Json? // Staff override decision if any
  staffNotes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([uploadedFileId])
}

// Store completeness orchestrator results at the claim level
model ClaimReadiness {
  id String @id @default(cuid())

  // Relations
  intakeSessionId String        @unique
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  // Readiness Assessment
  readinessScore       Float // 0-100
  isReadyForSubmission Boolean @default(false)

  // Completeness by Category
  completeness Json // Structured data about what's complete vs missing

  // Issues
  criticalBlockers Json[] // Issues preventing submission
  warnings         Json[] // Issues that should be reviewed

  // Cross-Document Validation
  nameConsistent      Boolean    @default(true)
  datesConsistent     Boolean    @default(true)
  claimTypeConfidence Float? // 0-1
  detectedClaimType   ClaimType?

  // Last Assessment
  lastAssessedAt    DateTime @default(now())
  assessmentVersion String   @default("1.0") // For tracking algorithm changes

  // Staff Review
  staffReviewStatus ClaimReviewStatus @default(PENDING)
  reviewedBy        String? // Staff user ID
  reviewedAt        DateTime?
  staffDecision     Json? // Staff decision and reasoning

  // AI Quality Assurance Reviews
  aiReviewQA AIReviewQA?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([readinessScore])
  @@index([isReadyForSubmission])
  @@index([staffReviewStatus])
}

// Audit trail of all AI agent executions
model AgentExecutionLog {
  id String @id @default(cuid())

  // Agent Info
  agentName    String // e.g., "ClassifierAgent", "IdentityVerificationAgent"
  agentVersion String // For tracking agent changes

  // Relations
  uploadedFileId String?
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)

  intakeSessionId String?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: SetNull)

  // Execution Details
  status AgentExecutionStatus
  input  Json // Input parameters
  output Json? // Agent output
  error  String?              @db.Text // Error message if failed

  // Timing
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  executionTimeMs Int?

  // AI Model Info
  modelUsed     String? // e.g., "gpt-4o"
  tokensUsed    Int?
  estimatedCost Float? // USD

  @@index([agentName])
  @@index([status])
  @@index([uploadedFileId])
  @@index([intakeSessionId])
  @@index([startedAt])
}

// Audit trail of staff actions on claims
model StaffAction {
  id String @id @default(cuid())

  // Staff Member
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Target
  intakeSessionId String
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  // Action Details
  actionType StaffActionType
  actionData Json? // Additional data about the action
  notes      String?         @db.Text

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([intakeSessionId])
  @@index([actionType])
  @@index([createdAt])
}

// AI Review Quality Assurance - Track admin reviews of AI assessments
model AIReviewQA {
  id String @id @default(cuid())

  // What is being reviewed
  claimReadinessId String         @unique
  claimReadiness   ClaimReadiness @relation(fields: [claimReadinessId], references: [id], onDelete: Cascade)

  // Review Sampling
  sampledForReview Boolean   @default(false) // Randomly selected for QA review
  sampledAt        DateTime? // When it was selected for review

  // Reviewer
  reviewerId String?
  reviewer   User?   @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  // Review Status
  reviewStatus AIReviewQAStatus @default(PENDING)

  // Review Results - How accurate was the AI?
  aiAccuracyScore     Float? // 0-100: How accurate was the AI's assessment overall
  readinessScoreMatch Boolean? // Did reviewer agree with AI's readiness score?
  correctReadiness    Float? // What should the readiness score actually be (if different)

  // Specific Assessment Accuracy
  completenessAccurate     Boolean? // Was AI's completeness assessment accurate?
  criticalBlockersAccurate Boolean? // Were critical blockers correctly identified?
  warningsAccurate         Boolean? // Were warnings correctly identified?
  nameConsistencyAccurate  Boolean? // Was name consistency check accurate?
  datesConsistencyAccurate Boolean? // Was dates consistency check accurate?
  claimTypeAccurate        Boolean? // Was claim type detection accurate?

  // Detailed Feedback
  reviewerNotes          String? @db.Text // General notes about the review
  aiStrengths            String? @db.Text // What did the AI do well?
  aiWeaknesses           String? @db.Text // What did the AI miss or get wrong?
  improvementSuggestions String? @db.Text // Suggestions for improving AI prompts/logic

  // False Positives/Negatives
  falsePositives Json[] @default([]) // Issues AI flagged that weren't real
  falseNegatives Json[] @default([]) // Issues AI missed

  // Corrected Assessment
  correctedAssessment Json? // If needed, the corrected assessment data

  // Timestamps
  reviewStartedAt   DateTime?
  reviewCompletedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([claimReadinessId])
  @@index([reviewStatus])
  @@index([sampledForReview])
  @@index([reviewerId])
  @@index([aiAccuracyScore])
  @@index([createdAt])
}

// ============================================================================
// SERVICE TIERS & PAYMENT SYSTEM
// ============================================================================

enum ServiceTier {
  DIY_PREP // $149.99 setup + $24.99/mo - Document preparation only
  LEGAL_REP // No upfront cost - Full legal representation via Heritage Law
}

enum SubscriptionStatus {
  PENDING // Subscription created but payment not completed yet
  ACTIVE // Subscription is active and in good standing
  PAST_DUE // Payment failed, grace period
  CANCELED // User canceled subscription
  PAUSED // Temporarily paused (future feature)
}

enum PaymentType {
  SETUP_FEE // One-time $149.99 setup fee for DIY path
  MONTHLY_FEE // $24.99/mo subscription for DIY path
  FIRM_SERVICE_FEE // $1,000 paid by Heritage Law to RadiantClaims
}

enum PaymentStatus {
  PENDING // Payment initiated but not completed
  COMPLETED // Payment successful
  FAILED // Payment failed
  REFUNDED // Payment was refunded
}

// Service subscription - tracks which tier user is on and payment status
// Promo codes for discounts and pilot accounts
enum PromoCodeType {
  PERCENT_OFF // Percentage discount (e.g., 50% off)
  AMOUNT_OFF // Fixed amount discount (e.g., $50 off)
  FREE_TRIAL // Free trial period (days)
  PILOT_ACCOUNT // Full pilot account (free usage)
  WAIVE_SETUP // Waive setup fee only
}

enum PromoCodeDuration {
  ONCE // Apply discount once (first payment only)
  REPEATING // Apply for a specified number of months
  FOREVER // Apply forever (lifetime discount)
}

model PromoCode {
  id                    String                 @id @default(cuid())
  code                  String                 @unique // Human-readable code (e.g., "PILOT2025")
  type                  PromoCodeType
  description           String?                @db.Text
  // Discount values
  percentOff            Int? // 0-100
  amountOff             Float? // Dollar amount
  freeTrialDays         Int? // Number of days
  // Duration / Term
  duration              PromoCodeDuration      @default(ONCE)
  durationInMonths      Int? // For REPEATING duration, how many months
  // Path restrictions
  allowedTiers          String[]               @default([]) // e.g., ["DIY_PREP"] - empty = all allowed
  // Usage limits
  maxUses               Int? // Max number of redemptions (null = unlimited)
  currentUses           Int                    @default(0)
  expiresAt             DateTime? // Code expiration date
  isActive              Boolean                @default(true)
  // Access override (soft-open registration)
  accessOverrideEnabled Boolean                @default(false)
  accessSeatsTotal      Int?
  accessSeatsUsed       Int                    @default(0)
  // Stripe integration
  stripeCouponId        String?                @unique // Link to Stripe coupon
  // Archive support
  isArchived            Boolean                @default(false)
  archivedAt            DateTime?
  archivedBy            String?
  // Campaign support
  campaignName          String? // Group related promo codes
  useTieredDiscounts    Boolean                @default(false) // Enable tiered discount system
  // Metadata
  createdBy             String? // Admin user ID who created this
  notes                 String?                @db.Text // Internal notes
  // Relations
  subscriptions         ServiceSubscription[]
  tiers                 PromoCodeTier[] // Discount tiers
  usageHistory          PromoCodeUsage[] // Detailed usage tracking
  accessGrants          PromoCodeAccessGrant[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([isArchived])
  @@index([campaignName])
}

model PromoCodeTier {
  id             String           @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode        @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  tierOrder      Int // 1, 2, 3... (order of tiers)
  startAfterUses Int              @default(0) // Tier starts after X uses (0 for first tier)
  maxUsesInTier  Int? // Max uses in this tier (null = unlimited)
  percentOff     Int? // 0-100
  amountOff      Float? // Dollar amount
  description    String? // e.g., "Early bird discount"
  stripeCouponId String?          @unique // Cached Stripe coupon for this tier
  usages         PromoCodeUsage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([promoCodeId])
  @@index([promoCodeId, tierOrder])
}

model PromoCodeAccessGrant {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  email       String
  userId      String?
  grantedAt   DateTime  @default(now())

  @@unique([promoCodeId, email])
  @@index([promoCodeId])
  @@index([email])
}

model PromoCodeUsage {
  id                    String              @id @default(cuid())
  promoCodeId           String
  promoCode             PromoCode           @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  tierId                String?
  tier                  PromoCodeTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)
  serviceSubscriptionId String
  serviceSubscription   ServiceSubscription @relation(fields: [serviceSubscriptionId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountApplied       Float // Actual discount amount applied
  discountType          String // "PERCENT" or "AMOUNT"
  usedAt                DateTime            @default(now())
  ipAddress             String?
  userAgent             String?

  @@index([promoCodeId])
  @@index([userId])
  @@index([usedAt])
}

// ServiceSubscription - LEGACY NAME (kept for backwards compatibility)
// This is now a ONE-TIME SERVICE FEE, not a recurring subscription:
// - $499.99 one-time payment OR 2 installments of $249.99 each
// - No monthly recurring charges (old subscription model deprecated Dec 2024)
model ServiceSubscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   ServiceTier        @default(DIY_PREP)
  status SubscriptionStatus @default(ACTIVE)

  // One-Time Service Fee - $499.99 (or 2 installments of $249.99)
  setupFeePaid   Boolean   @default(false) // "setupFee" is legacy name, means "service fee paid"
  setupFeeAmount Float? // 499.99 one-time service fee
  setupFeePaidAt DateTime?

  // Installment Plan Support (2 payments of $249.99)
  isInstallmentPlan     Boolean @default(false) // True if user chose 2-payment plan
  installmentPaymentCount Int   @default(0) // Track number of payments made (max 2)
  installmentCompleted  Boolean @default(false) // True when all installments paid

  // DEPRECATED: Old monthly subscription fields (no longer used as of Dec 2024)
  monthlyFeeAmount Float? // DEPRECATED: No longer used (was $24.99)
  billingCycleDay  Int? // DEPRECATED
  nextBillingDate  DateTime?
  lastBillingDate  DateTime?

  // Promo Code / Pilot Account Support
  promoCodeId     String?
  promoCode       PromoCode? @relation(fields: [promoCodeId], references: [id])
  setupFeeWaived  Boolean    @default(false) // If true, no setup fee required
  discountPercent Int? // Discount percentage applied (0-100)
  discountAmount  Float? // Fixed discount amount applied
  isPilotAccount  Boolean    @default(false) // Special pilot/demo account
  pilotExpiresAt  DateTime? // Pilot account expiration date
  stripeCouponId  String? // Stripe coupon ID if applied

  // Legal Path Tracking (referral to Heritage Law)
  referredToFirmId     String?
  referredToFirm       LawFirm?  @relation(fields: [referredToFirmId], references: [id])
  referredAt           DateTime?
  firmServiceFee       Float? // 1000.00
  firmServiceFeePaid   Boolean   @default(false)
  firmServiceFeePaidAt DateTime?

  // Stripe Integration
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Lifecycle
  startedAt    DateTime  @default(now())
  canceledAt   DateTime?
  cancelReason String?   @db.Text

  // Relations
  payments          Payment[]
  intakeSessions    IntakeSession[]
  promoCodeUsages   PromoCodeUsage[] // Detailed promo code usage tracking
  claimSubscriptions ClaimSubscription[] // Per-claim subscriptions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tier])
  @@index([status])
  @@index([nextBillingDate])
  @@index([referredToFirmId])
  @@index([promoCodeId])
  @@index([isPilotAccount])
}

// Per-claim subscription tracking
// Each claim gets its own subscription with individual pricing
model ClaimSubscription {
  id                   String              @id @default(cuid())
  claimantId           String              @unique
  claimant             Claimant            @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  serviceSubscriptionId String
  serviceSubscription  ServiceSubscription @relation(fields: [serviceSubscriptionId], references: [id], onDelete: Cascade)

  // Claim order tracking (for pricing tier)
  claimOrder           Int // 1 = first claim ($24.99/mo), 2+ = additional ($14.99/mo)

  // Per-claim setup fee
  setupFeePaid         Boolean             @default(false)
  setupFeeAmount       Float // DIY: 149.99, Lawyer: 89.99
  setupFeePaidAt       DateTime?
  setupFeeRefunded     Boolean             @default(false) // Lawyer track: refundable on claim receipt
  setupFeeRefundedAt   DateTime?

  // Monthly fee (calculated based on claimOrder)
  monthlyFeeAmount     Float // $24.99 for claimOrder=1, $14.99 for claimOrder>1

  // Lawyer track: no discount on additional claims
  lawyerTrackNoDiscount Boolean           @default(false)

  // Stripe tracking (individual subscription per claim)
  stripeSubscriptionId String?            @unique
  stripePriceId        String? // The Stripe price ID for this claim's monthly fee

  // Lifecycle
  status               SubscriptionStatus  @default(ACTIVE)
  startedAt            DateTime            @default(now())
  canceledAt           DateTime?
  cancelReason         String?             @db.Text

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([serviceSubscriptionId])
  @@index([claimantId])
  @@index([status])
  @@index([claimOrder])
}

// Payment tracking - all payment events
model Payment {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   ServiceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  paymentType PaymentType
  amount      Float // Amount in USD
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)

  // Stripe Integration
  stripePaymentIntentId String? @unique
  stripeChargeId        String?
  stripeInvoiceId       String?

  // Lifecycle
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text
  refundedAt    DateTime?
  refundReason  String?   @db.Text

  // Metadata
  metadata String? @db.Text // JSON for additional context

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([paymentType])
  @@index([paidAt])
}

// ============================================================================
// REGISTRATION WAITLIST - Lead Collection During Registration Lockdown
// ============================================================================

enum WaitlistStatus {
  PENDING // Waiting to be converted to account
  CONTACTED // We've reached out to them
  CONVERTED // Successfully converted to user account
  DECLINED // They declined when contacted
  INVALID // Invalid email or spam
}

model RegistrationWaitlist {
  id String @id @default(cuid())

  // Lead Information
  email          String       @unique
  name           String?
  phone          String? // Optional phone number
  claimType      ClaimType? // Optional - what type of claim they're interested in
  interestedTier ServiceTier? // DIY_PREP or LEGAL_REP - which path they're interested in
  firmPreference String? // If LEGAL_REP, which firm they want to work with

  // Source Tracking
  source       String? // "register_page", "reca_signup", "intake_page", "service_tiers"
  referralCode String? // If they came through a referral
  utmSource    String? // Marketing attribution
  utmMedium    String?
  utmCampaign  String?

  // Engagement Data
  status         WaitlistStatus @default(PENDING)
  notes          String?        @db.Text // Staff notes
  submittedCount Int            @default(1) // How many times they tried to register
  lastSubmitIp   String?

  // Communication Tracking
  notificationSent   Boolean   @default(false)
  notificationSentAt DateTime?
  contactedAt        DateTime?
  contactedBy        String? // Staff member who reached out

  // Conversion
  convertedToUserId String?   @unique // Link to created User
  convertedAt       DateTime?
  convertedBy       String? // Staff member who created account

  // Metadata
  metadata  Json? // Additional flexible data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([claimType])
  @@index([interestedTier])
}

// ============================================================================
// RESOURCE FEEDBACK & QUALITY TRACKING
// ============================================================================

enum ResourceSource {
  DATABASE // Manually entered/curated resource
  WEB_SEARCH // Found via Tavily/web search
  AI_SUGGESTED // Suggested by AI
  USER_SUBMITTED // User submitted this resource
  STAFF_VERIFIED // Staff verified and cleaned up
}

enum ResourceVerificationStatus {
  UNVERIFIED // Not yet verified by staff
  VERIFIED // Staff verified this is accurate
  NEEDS_UPDATE // Needs information update
  DEPRECATED // No longer valid/active
  DUPLICATE // Duplicate of another resource
}

enum ResourceFeedbackType {
  WAS_HELPFUL // User confirmed resource was helpful
  NOT_HELPFUL // User said it wasn't helpful
  CONTACTED // User contacted this resource
  DOCUMENT_OBTAINED // User successfully got document from here
  INCORRECT_INFO // Contact info was wrong
  NO_RESPONSE // Resource didn't respond
  ALREADY_CLOSED // Office/resource is closed
  WRONG_RESOURCE // This wasn't the right place for their need
}

// Track when we show a resource to a user (for follow-up)
model ResourceInteraction {
  id         String   @id @default(cuid())
  resourceId String
  resource   DocumentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Who we showed it to
  userId     String?
  sessionId  String?
  email      String? // For follow-up

  // Context
  documentType String // What they were looking for
  shownVia     String @default("chat_bot") // "chat_bot", "resource_page", "email"
  searchQuery  String? @db.Text // Original user query

  // Immediate feedback (thumbs up/down)
  immediatelyHelpful  Boolean? // true = thumbs up, false = thumbs down
  immediateFeedbackAt DateTime?
  immediateComments   String? @db.Text // Why thumbs down

  // Follow-up tracking
  followUpScheduledFor DateTime // When to send follow-up
  followUpSentAt       DateTime?
  followUpMethod       String? // "email", "sms", "modal"
  followUpCompletedAt  DateTime?
  followUpReminderSent Boolean  @default(false)

  // Link to detailed feedback (if provided)
  feedbackId String?           @unique
  feedback   ResourceFeedback? @relation(fields: [feedbackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId])
  @@index([userId])
  @@index([followUpScheduledFor, followUpSentAt])
  @@index([followUpCompletedAt])
  @@index([createdAt])
}

// Track user feedback on resources to improve quality
model ResourceFeedback {
  id         String   @id @default(cuid())
  resourceId String
  resource   DocumentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Who provided feedback
  userId     String?
  sessionId  String? // For anonymous users
  email      String? // Optional contact

  // Feedback details
  feedbackType ResourceFeedbackType
  rating       Int? // 1-5 stars
  wasHelpful   Boolean? // Simple thumbs up/down

  // Detailed feedback
  documentType String? // What document they were seeking
  comments     String? @db.Text
  contactedAt  DateTime? // When they contacted the resource
  responseTime String? // "same_day", "within_3_days", "within_week", "1_2_weeks", "2_4_weeks", "no_response"
  successfullyObtained Boolean? // Did they get the document?

  // Cost & Time tracking
  actualCost           Float? // What they actually paid
  actualProcessingDays Int? // How long it actually took

  // Metadata
  ipAddress  String?
  userAgent  String?
  metadata   Json? // Additional context

  // Link back to interaction
  interaction ResourceInteraction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId])
  @@index([feedbackType])
  @@index([wasHelpful])
  @@index([userId])
  @@index([createdAt])
}

// Aggregate statistics for resources to show social proof
model ResourceStats {
  id         String @id @default(cuid())
  resourceId String @unique

  // Usage stats
  totalSearches   Int @default(0) // Times shown in search
  totalSelections Int @default(0) // Times user clicked/selected
  totalFeedback   Int @default(0) // Total feedback submissions

  // Feedback breakdown
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)
  contactedCount  Int @default(0)
  successCount    Int @default(0) // Successfully obtained document

  // Averages
  avgRating            Float? // Average star rating
  avgActualCost        Float? // Average reported cost
  avgProcessingDays    Float? // Average reported processing time
  avgResponseTime      String? // Most common response time

  // Quality indicators
  helpfulnessRate Float? // % of feedback that was positive
  successRate     Float? // % that successfully got document

  // Last updated
  lastFeedbackAt DateTime?
  updatedAt      DateTime @updatedAt

  @@index([helpfulnessRate])
  @@index([successRate])
  @@index([totalSearches])
}

// ============================================================================
// RAG & VECTOR SEARCH
// ============================================================================

model RecaLibrary {
  id             String   @id @default(cuid())
  content        String   @db.Text
  sourceDocument String // Filename (e.g. "RECA_2025_Amendment.pdf")
  pageNumber     Int?
  section        String?
  embedding      Unsupported("vector(1536)")
  
  // New fields for scoping
  isPublic       Boolean   @default(true) // True = Global Law/Rules
  claimantId     String?   // If set, ONLY accessible when discussing this claimant
  claimant       Claimant? @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  uploadedBy     String?   // Admin/Attorney who added it
  
  // Link to source file
  knowledgeSourceId String?
  knowledgeSource   KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([claimantId])
  @@index([knowledgeSourceId])
}

model KnowledgeSource {
  id          String   @id @default(cuid())
  fileName    String
  fileKey     String   // R2 Key
  mimeType    String
  sizeBytes   Int
  
  isPublic    Boolean  @default(true)
  claimantId  String?
  claimant    Claimant? @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  
  chunkCount  Int      @default(0)
  
  recaLibraryEntries RecaLibrary[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([claimantId])
  @@index([isPublic])
}

// Chat History Models
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?       // Link to User (optional for guests)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimantId String?      // Link to a specific claim context
  claimant  Claimant?     @relation(fields: [claimantId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  title     String?       // Auto-generated title from first message
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([claimantId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user", "assistant", "system"
  content   String      @db.Text
  metadata  Json?       // Store function calls, tool outputs, citations, etc.

  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// Medical Record Sources - Track hospitals/facilities for medical records
model MedicalRecordSource {
  id                String    @id @default(cuid())
  claimantId        String
  claimant          Claimant  @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  // Hospital/Facility Information
  facilityName      String
  streetAddress     String?
  city              String?
  state             String?
  zipCode           String?
  phoneNumber       String?

  // Operation Dates (for validation)
  yearOpened        Int?
  yearClosed        Int?
  stillOperating    Boolean   @default(true)

  // Treatment Information
  treatmentYear     Int?      // Year patient was treated at this facility
  treatmentType     String?   // Type of treatment (e.g., "Radiation", "Chemotherapy")

  // Metadata
  source            String    @default("USER_ENTERED") // "USER_ENTERED", "WEB_SEARCH", "DATABASE"
  webSearchResult   Boolean   @default(false) // Was this from web search?
  requestGenerated  Boolean   @default(false) // Has request packet been generated?
  requestedAt       DateTime? // When request was made
  receivedAt        DateTime? // When records were received

  // Notes
  notes             String?   @db.Text

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([claimantId])
  @@index([treatmentYear])
  @@index([requestGenerated])
}

// ============================================================================
// DOJ Data Scraping System
// ============================================================================

// DOJClaimCategory enum for DOJ statistics
enum DOJClaimCategory {
  DOWNWINDER
  ONSITE_PARTICIPANT
  MANHATTAN_PROJECT_WASTE
  URANIUM_WORKER
}

// TrendDirection for metrics analysis
enum TrendDirection {
  FASTER
  SLOWER
  STABLE
}

// MetricWindow for time-based analysis
enum MetricWindow {
  LAST_7_DAYS
  LAST_14_DAYS
  LAST_30_DAYS
  LAST_60_DAYS
  ALL_TIME
}

// Lead Status - tracking claimant conversion funnel
enum LeadStatus {
  NEW                    // Just completed eligibility
  CONTACTED              // We've reached out
  ENGAGED                // They responded to follow-up
  NURTURING              // In follow-up sequence
  CONVERTED              // Signed up and started claim
  CHURNED                // Decided not to proceed
  INELIGIBLE             // Not eligible for RECA
  COLD                   // No response after multiple attempts
}

// Conversion Stage - where in the funnel
enum ConversionStage {
  ELIGIBILITY_COMPLETED  // Finished eligibility check
  ACCOUNT_CREATED        // Signed up but hasn't started form
  FORM_STARTED           // Started RECA form
  FORM_IN_PROGRESS       // Working through form sections
  PAYMENT_PENDING        // Needs to pay for service tier
  PAYMENT_COMPLETED      // Paid, has active subscription
  FORM_COMPLETED         // Finished entire form
  PDF_GENERATED          // PDF created
  PDF_DOWNLOADED         // Downloaded PDF
  SUBMITTED_TO_DOJ       // Claim submitted to DOJ
}

// DOJ Daily Statistics - scraped from justice.gov/civil/awards-date-MMDDYYYY
model DOJDailyStats {
  id               String             @id @default(cuid())

  // Date tracking
  reportDate       DateTime           // Date from URL (e.g., 12/05/2024)
  scrapedAt        DateTime           @default(now())

  // Claim type
  claimCategory    DOJClaimCategory

  // Under PL 119-21 (current law, starting 7/3/2025)
  pending          Int
  approved         Int
  approvalPercent  Float
  dollarsApproved  Float     // In dollars (e.g., 39100000)
  denied           Int
  totalClaims      Int

  // Calculated fields (vs previous day)
  dailyApproved    Int?      // Approved today vs yesterday
  dailyDenied      Int?      // Denied today vs yesterday
  dailySubmitted   Int?      // New submissions today

  // Processing velocity
  approvalRate     Float?    // Claims approved per day (rolling avg)

  // Data quality
  dataSource       String    @default("justice.gov")
  scrapingSuccess  Boolean   @default(true)
  scrapingError    String?   @db.Text

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([reportDate, claimCategory])
  @@index([reportDate])
  @@index([claimCategory, reportDate])
  @@index([scrapedAt])
}

// DOJ Processing Metrics - calculated from daily stats
model DOJProcessingMetrics {
  id                    String             @id @default(cuid())

  // Time window
  claimCategory         DOJClaimCategory
  windowStart           DateTime
  windowEnd             DateTime
  windowType            MetricWindow

  // Velocity metrics
  avgApprovalsPerDay    Float
  medianApprovalsPerDay Float
  avgSubmissionsPerDay  Float

  // Capacity metrics
  avgPendingQueue       Float
  avgProcessingTime     Float?        // Days from submission to approval (estimated)

  // Success metrics
  approvalRate          Float
  denialRate            Float

  // Trend analysis
  velocityTrend         TrendDirection
  velocityChange        Float         // % change from previous period
  queueTrend            TrendDirection
  queueChange           Float

  // Sample
  daysInSample          Int

  // Metadata
  calculatedAt          DateTime           @default(now())

  @@index([claimCategory, windowType])
  @@index([calculatedAt])
}
