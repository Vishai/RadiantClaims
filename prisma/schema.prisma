// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  CUSTOMER
  ADMIN
  ATTORNEY // Attorney user from partner firm
  FIRM_ADMIN // Law firm administrator
  STAFF_REVIEWER // Can review claims and AI results
  SENIOR_REVIEWER // Can approve/reject claims
}

model User {
  id                          String                      @id @default(cuid())
  name                        String?
  email                       String?                     @unique
  emailVerified               DateTime?
  password                    String?
  image                       String?
  role                        UserRole                    @default(CUSTOMER)
  firmId                      String? // Link to law firm for attorneys
  firm                        LawFirm?                    @relation(fields: [firmId], references: [id], onDelete: SetNull)
  accounts                    Account[]
  sessions                    Session[]
  claimants                   Claimant[] // Customer users can have multiple claims
  auditLogs                   AuditLog[]
  mfaEnabled                  Boolean                     @default(false)
  mfaConfig                   MFAConfig?
  rememberMeTokens            RememberMeToken[]
  passwordChangedAt           DateTime?
  passwordResetRequired       Boolean                     @default(false)
  passwordResetToken          String?                     @unique
  passwordResetExpires        DateTime?
  policyAcceptances           PolicyAcceptance[]
  comments                    ClaimantComment[]
  reviewActions               ReviewAction[]
  notifications               Notification[]
  serviceSubscription         ServiceSubscription? // Link to subscription
  staffActions                StaffAction[] // NEW: AI validation staff actions
  aiReviewQAs                 AIReviewQA[] // AI assessment reviews performed by this user
  chatSessions                ChatSession[]
  uploadedKnowledge           KnowledgeSource[]
  promoCodeUsages             PromoCodeUsage[] // Promo codes used by this user
  documentAssistancesAssigned DocumentRequestAssistance[] @relation("DocumentAssistanceAssignedStaff") // Claimants receiving staff assistance

  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([email])
  @@index([role])
  @@index([firmId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// RadiantClaims domain models
model Referral {
  id           String     @id @default(cuid())
  code         String     @unique
  referrerName String
  contact      String?
  notes        String?    @db.Text
  claimants    Claimant[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([code])
}

model Claimant {
  id                      String                           @id @default(cuid())
  userId                  String? // Link to User account (nullable for legacy)
  user                    User?                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String
  email                   String
  phone                   String
  dob                     DateTime
  address1                String
  address2                String?
  city                    String
  county                  String
  state                   String
  postalCode              String
  referralCode            String?
  referral                Referral?                        @relation(fields: [referralCode], references: [code])
  documents               Document[]
  intakeSession           IntakeSession?
  firmAssignments         ClaimantAssignment[] // Assigned law firms
  comments                ClaimantComment[] // Comments from attorneys/staff
  reviewActions           ReviewAction[] // Review history
  notifications           Notification[] // Related notifications
  attorneyActivities      AttorneyActivityLog[]
  followUps               ClaimantFollowUp[]
  documentAssistances     DocumentRequestAssistance[]
  followUpPriority        FollowUpPriorityQueue?
  medicalRecordSources    MedicalRecordSource[] // Medical facilities for record requests
  // NEW FIELDS FOR RECA DOCUMENTATION
  claimType               ClaimType?
  relationshipToClaimant  RelationshipType?
  cancerType              String? // Reference to specific cancer
  eligibilityData         Json? // Stores eligibility screening data for workflow pre-population
  // LEAD TRACKING & CONVERSION
  leadStatus              LeadStatus                       @default(NEW) // Track conversion funnel
  eligibilityStatus       String? // "likely", "unlikely", "ineligible", "needs-review"
  lastContactedAt         DateTime? // Last follow-up attempt
  followUpCount           Int                              @default(0) // Number of follow-up attempts
  conversionStage         ConversionStage                  @default(ELIGIBILITY_COMPLETED) // Where they are in the funnel
  teacupReason            String? // Why they didn't complete (if applicable)
  documentStatuses        ClaimantDocumentStatus[]
  chatSessions            ChatSession[]
  privateContextDocuments RecaLibrary[]
  knowledgeSources        KnowledgeSource[]
  // CLAIM LIFECYCLE TRACKING
  lifecycle               ClaimLifecycle?
  queuePosition           ClaimQueuePosition?
  notificationPreferences LifecycleNotificationPreference?
  // PER-CLAIM SUBSCRIPTION
  claimSubscription       ClaimSubscription?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@index([userId])
  @@index([email])
  @@index([lastName])
  @@index([state])
  @@index([referralCode])
}

enum DocumentType {
  ID
  Medical
  ProofOfResidency
  Other
}

model Document {
  id           String       @id @default(cuid())
  claimantId   String
  claimant     Claimant     @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileKey      String // S3/R2 object key
  originalName String
  mimeType     String
  size         Int // in bytes
  createdAt    DateTime     @default(now())

  @@index([claimantId])
  @@index([type])
}

// Step 2 Intake System Models

enum IntakeStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUBMITTED
}

enum IntakeStep {
  SCREENING
  IDENTITY
  RESIDENCE
  MEDICAL
  ADDITIONAL
  CONSENT
  REVIEW
}

enum ClaimType {
  PANCREATIC_CANCER
  THYROID_CANCER
  KIDNEY_CANCER
  LUNG_CANCER
  BRAIN_CANCER
  OTHER_CANCER
  NON_CANCER
  // RECA-specific claim types
  DOWNWINDER
  URANIUM_WORKER
  MANHATTAN_PROJECT_WASTE
  ONSITE_PARTICIPANT
}

// Main intake session - allows save/resume without account
model IntakeSession {
  id                    String            @id @default(cuid())
  resumeToken           String            @unique // Magic link token
  claimantId            String?           @unique
  claimant              Claimant?         @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  currentStep           IntakeStep        @default(SCREENING)
  status                IntakeStatus      @default(DRAFT)
  claimType             ClaimType?
  isPremiumService      Boolean           @default(false) // DEPRECATED: Use serviceSubscription.tier instead
  completedSteps        String[]          @default([]) // Array of completed step names
  expiresAt             DateTime // Token expiration (7 days default)
  lastActivityAt        DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  intakeResponses       IntakeResponse[]
  uploadedFiles         UploadedFile[]
  consentRecords        ConsentRecord[]
  packetSubmission      PacketSubmission?
  // RECA Workflow Fields
  recaWorkflowStage     Int? // 1-5 for workflow stages (1=eligibility, 2=form, 3=supporting, 4=docs, 5=review)
  recaWorkflowSection   String? // Current section (e.g., "part_1", "part_8", "supporting_forms")
  recaFormData          Json? // All form field values from parts 1-16
  recaEligibilityData   Json? // Eligibility assessment results (relationship, exposure, disease)
  recaCompletionPercent Int?              @default(0) // 0-100 progress tracking
  recaSupportingForms   Json? // Supporting forms data (medical release, identity cert, tribal, beneficiaries)
  recaValidationErrors  Json? // Current validation errors by section

  // PDF Generation & Download Tracking (for refund policy enforcement)
  recaFormPdfGenerated     Boolean   @default(false)
  recaFormPdfGeneratedAt   DateTime?
  recaFormPdfDownloaded    Boolean   @default(false) // Once true, refund is not allowed
  recaFormPdfDownloadedAt  DateTime?
  recaFormPdfDownloadCount Int       @default(0)

  // Service Subscription Link
  serviceSubscriptionId String?
  serviceSubscription   ServiceSubscription? @relation(fields: [serviceSubscriptionId], references: [id])

  // NEW: AI Validation Relations
  claimReadiness          ClaimReadiness?
  agentLogs               AgentExecutionLog[]
  staffActions            StaffAction[]
  attorneyActivityLogs    AttorneyActivityLog[]
  followUps               ClaimantFollowUp[]
  documentAssistances     DocumentRequestAssistance[]
  AttorneyNotificationLog AttorneyNotificationLog[]
  externalUploadTokens    ExternalUploadToken[]

  @@index([resumeToken])
  @@index([claimantId])
  @@index([status])
  @@index([expiresAt])
  @@index([recaWorkflowStage])
  @@index([serviceSubscriptionId])
}

// Screening questions and answers for conditional logic
model IntakeResponse {
  id              String        @id @default(cuid())
  intakeSessionId String
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  questionKey     String // e.g., "exposure_location", "diagnosis_year"
  questionText    String        @db.Text
  answerValue     String        @db.Text // JSON for complex answers
  createdAt       DateTime      @default(now())

  @@unique([intakeSessionId, questionKey])
  @@index([intakeSessionId])
  @@index([questionKey])
}

enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  REJECTED
  VALIDATED // Staff validated the digital copy
  AWAITING_REVIEW // Ready for lawyer review
  APPROVED // Lawyer approved for submission
}

enum CustomerFileStatus {
  PROCESSING // AI validation in progress
  VERIFIED // All good, show green checkmark
  NEEDS_REVIEW // Issues found, show warning
  ERROR // Processing failed
}

enum FileCategory {
  IDENTITY
  PROOF_OF_RESIDENCE
  PATHOLOGY_REPORT
  MEDICAL_RECORDS
  DISCHARGE_SUMMARY
  TUMOR_REGISTRY
  TREATMENT_RECORDS
  UTILITY_BILL
  MORTGAGE_STATEMENT
  TAX_RETURN
  SCHOOL_RECORDS
  EMPLOYMENT_RECORDS
  LDS_CHURCH_RECORDS
  DEATH_CERTIFICATE
  BIRTH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  OTHER
}

// Enhanced file tracking with OCR + metadata
model UploadedFile {
  id               String            @id @default(cuid())
  intakeSessionId  String
  intakeSession    IntakeSession     @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  fileKey          String            @unique // R2 object key
  originalFilename String
  normalizedName   String? // Auto-suggested: last_first_residence_2020.pdf
  mimeType         String
  sizeBytes        Int
  category         FileCategory?
  status           FileStatus        @default(UPLOADING)
  ocrText          String?           @db.Text // Extracted text
  ocrConfidence    Float? // 0-1 confidence score
  metadata         String?           @db.Text // JSON: extracted dates, names, etc.
  thumbnailKey     String? // Preview image for PDFs/images
  isRequired       Boolean           @default(false)
  requiresOriginal Boolean           @default(false) // Document must be mailed as original
  rejectionReason  String?           @db.Text
  categoryLocked   Boolean           @default(false)
  categoryLockedAt DateTime?
  categoryLockedBy String?
  validatedBy      String? // Staff member who validated
  validatedAt      DateTime?
  reviewedBy       String? // Lawyer who reviewed
  reviewedAt       DateTime?
  reviewNotes      String?           @db.Text
  uploadedAt       DateTime          @default(now())
  processedAt      DateTime?
  tags             DocumentTag[]
  comments         ClaimantComment[] // Comments related to this file

  // NEW: AI Validation Fields
  customerStatus       CustomerFileStatus  @default(PROCESSING)
  userNotes            String?             @db.Text
  userConfirmed        Boolean             @default(false)
  userReportedIssue    String?             @db.Text
  extractedDataSummary Json? // Flattened key data for quick access
  validation           DocumentValidation? // NEW: AI validation relation
  agentLogs            AgentExecutionLog[] // NEW: Agent execution logs

  @@index([intakeSessionId])
  @@index([fileKey])
  @@index([category])
  @@index([status])
  @@index([customerStatus])
}

// Auto-tagging system
model DocumentTag {
  id             String       @id @default(cuid())
  uploadedFileId String
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  tag            String // e.g., "needs_redaction", "blurry", "missing_date"
  confidence     Float? // AI confidence 0-1
  createdAt      DateTime     @default(now())

  @@index([uploadedFileId])
  @@index([tag])
}

enum ConsentType {
  RECORDS_AUTHORIZATION
  ATTORNEY_SHARING
  HIPAA_AUTHORIZATION
  E_SIGNATURE
}

// Legal consent + e-signature tracking
model ConsentRecord {
  id              String        @id @default(cuid())
  intakeSessionId String
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  consentType     ConsentType
  consentText     String        @db.Text // Full text of what was agreed to
  signatureData   String?       @db.Text // Base64 signature image or typed name
  ipAddress       String
  userAgent       String?       @db.Text
  agreedAt        DateTime      @default(now())

  @@index([intakeSessionId])
  @@index([consentType])
}

enum PacketStatus {
  PENDING
  GENERATING
  READY
  OUTDATED
  DELIVERED
  FAILED
  PRINTED // Digital copies printed for review
  READY_TO_MAIL // Approved and ready for client to mail
  MAILED_BY_CLIENT // Client confirmed they mailed it
}

// Final packet assembly tracking
model PacketSubmission {
  id                    String             @id @default(cuid())
  intakeSessionId       String             @unique
  intakeSession         IntakeSession      @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  packetFileKey         String? // R2 key for final PDF
  status                PacketStatus       @default(GENERATING)
  fileCount             Int                @default(0)
  totalSizeBytes        Int                @default(0)
  generatedAt           DateTime?
  readyAt               DateTime?
  deliveredAt           DateTime?
  deliveredTo           String? // Attorney email
  printedAt             DateTime? // When digital copies were printed
  printedBy             String? // Staff who printed
  mailingInstructions   String?            @db.Text // Custom instructions for claimant
  trackingNumber        String? // If prepaid envelope has tracking
  prepaidEnvelopeIssued Boolean            @default(false)
  errorMessage          String?            @db.Text
  archiveKey            String?
  archiveFileName       String?
  archiveSizeBytes      Int                @default(0)
  archiveChecksum       String?
  version               Int                @default(0)
  warnings              Json?
  lastDownloadedAt      DateTime?
  downloadCount         Int                @default(0)
  generations           PacketGeneration[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status])
  @@index([generatedAt])
}

model PacketGeneration {
  id                 String           @id @default(cuid())
  packetSubmissionId String
  packetSubmission   PacketSubmission @relation(fields: [packetSubmissionId], references: [id], onDelete: Cascade)
  version            Int
  status             PacketStatus     @default(GENERATING)
  archiveKey         String?
  archiveSizeBytes   Int?
  warnings           Json?
  generatedBy        String?
  generatedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())

  @@index([packetSubmissionId])
  @@index([version])
  @@index([status])
}

// Jurisdiction-specific document requirements
model JurisdictionRequirement {
  id                   String   @id @default(cuid())
  state                String // e.g., "UT", "NV", "AZ"
  county               String? // Optional for county-specific requirements
  documentCategory     String // Maps to FileCategory
  requiresOriginal     Boolean  @default(false)
  isRequired           Boolean  @default(true)
  specificInstructions String?  @db.Text
  helpfulLinks         String?  @db.Text // JSON array of {title, url}
  exampleDocuments     String?  @db.Text // JSON array of example doc types
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([state, county, documentCategory])
  @@index([state])
  @@index([state, county])
}

// Email preferences and unsubscribe tracking
enum EmailType {
  WELCOME
  RESUME_LINK
  UPLOAD_CONFIRMATION
  PACKET_READY
  DOCUMENT_VALIDATED
  READY_TO_MAIL
  MARKETING
  UPDATES
  ATTORNEY_NEW_CLIENT
  ATTORNEY_ACTIVITY_SUMMARY
  ATTORNEY_PACKET_READY
  CLIENT_DOCUMENT_FOLLOW_UP
  CLIENT_PROGRESS_MILESTONE
  CLIENT_REENGAGEMENT
  CLIENT_DOCUMENT_ASSISTANCE
  RESOURCE_FOLLOW_UP // Initial follow-up for resource feedback
  RESOURCE_ALTERNATIVES // Second follow-up with alternatives
  RESOURCE_SUCCESS // Success confirmation with upload prompt
  WAITLIST_CONFIRMATION // Waitlist signup confirmation
  PAYMENT_CONFIRMATION // Payment/checkout success confirmation
  PAYMENT_FAILED // Payment failure notification
  INTAKE_STARTED // First form save / intake session started
  PASSWORD_CHANGED // Password change confirmation
  FIRM_ONBOARDING // Law firm onboarding
  ATTORNEY_WELCOME // Attorney account welcome
}

model EmailPreference {
  id               String    @id @default(cuid())
  email            String
  emailType        EmailType
  isUnsubscribed   Boolean   @default(false)
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([email, emailType])
  @@index([email])
  @@index([unsubscribeToken])
}

// Security & Compliance Models (SOC 2)

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENABLED
  MFA_DISABLED
  SESSION_CREATED
  SESSION_TERMINATED
  CLAIMANT_VIEWED
  CLAIMANT_CREATED
  CLAIMANT_UPDATED
  CLAIMANT_DELETED
  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
  DOCUMENT_DELETED
  INTAKE_STARTED
  INTAKE_COMPLETED
  PACKET_GENERATED
  UNAUTHORIZED_ACCESS_ATTEMPT
  PERMISSION_DENIED
  // Attorney Portal Actions
  FIRM_CREATED
  FIRM_UPDATED
  FIRM_SUSPENDED
  ATTORNEY_INVITED
  ATTORNEY_REMOVED
  CLAIMANT_ASSIGNED
  CLAIMANT_UNASSIGNED
  POLICY_ACCEPTED
  COMMENT_ADDED
  COMMENT_DELETED
  REVIEW_APPROVED
  REVIEW_REJECTED
  REVISION_REQUESTED
  NOTIFICATION_SENT
  WORKFLOW_STATUS_CHANGED
  // Service Subscription Actions
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_REQUESTED
  REFUND_PROCESSED
  FIRM_SERVICE_FEE_PAID
  PDF_DOWNLOADED
  // Promo Code Actions
  PROMO_CODE_CREATED
  PROMO_CODE_UPDATED
  PROMO_CODE_ARCHIVED
  PROMO_CODE_UNARCHIVED
  // Admin Application Editor Actions
  ADMIN_EDITED_FORM
  ADMIN_REGENERATED_PACKET
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model AuditLog {
  id           String        @id @default(cuid())
  userId       String? // Null for anonymous/failed login attempts
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  severity     AuditSeverity @default(INFO)
  resourceType String? // e.g., "User", "Claimant", "Document"
  resourceId   String? // ID of affected resource
  ipAddress    String
  userAgent    String?       @db.Text
  metadata     String?       @db.Text // JSON with additional context
  success      Boolean       @default(true)
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
  @@index([resourceType, resourceId])
}

enum MFAMethod {
  TOTP // Time-based One-Time Password (Google Authenticator, Authy)
  SMS // Future: SMS-based verification
  EMAIL // Future: Email-based verification
}

model MFAConfig {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      MFAMethod
  secret      String // Encrypted TOTP secret
  backupCodes String[] // Encrypted backup codes
  isEnabled   Boolean   @default(false)
  enabledAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model RememberMeToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Hashed token
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expires])
}

// ===== Attorney Portal Models =====

enum FirmStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// Law firm multi-tenancy
model LawFirm {
  id                       String                       @id @default(cuid())
  name                     String
  slug                     String                       @unique // URL-safe identifier
  address                  String?
  city                     String?
  state                    String?
  postalCode               String?
  phone                    String?
  email                    String?                      @unique
  status                   FirmStatus                   @default(ACTIVE)
  licenseNumber            String? // Bar association number
  primaryContactName       String?
  primaryContactEmail      String?
  users                    User[] // Attorney users at this firm
  claimantAssignments      ClaimantAssignment[]
  policyAcceptances        PolicyAcceptance[]
  referredSubscriptions    ServiceSubscription[] // Subscriptions referred to this firm
  notificationSettings     LawFirmNotificationSetting[]
  notificationSchedule     LawFirmNotificationSchedule?
  serviceAgreementUrl      String? // Signed service provider agreement
  serviceAgreementDate     DateTime?
  attorneyActivityLogs     AttorneyActivityLog[]
  attorneyNotificationLogs AttorneyNotificationLog[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([slug])
  @@index([status])
  @@index([email])
}

enum ClaimantWorkflowStatus {
  INTAKE // Claimant filling out intake
  DOCUMENTS_PENDING // Waiting for document uploads
  INTERNAL_REVIEW // Radiant Claims staff review
  READY_FOR_ATTORNEY // Ready for attorney review
  ATTORNEY_REVIEWING // Attorney actively reviewing
  REVISION_REQUESTED // Attorney requested changes
  ATTORNEY_APPROVED // Attorney approved for submission
  PACKET_PRINTED // Physical packet printed
  MAILING_READY // Ready for client to mail
  CLIENT_MAILED // Client confirmed mailing
  DOJ_SUBMITTED // Submitted to DOJ
  DOJ_PROCESSING // DOJ is processing
  APPROVED // DOJ approved
  REJECTED // DOJ rejected
  WITHDRAWN // Claim withdrawn
}

enum LawFirmNotificationEvent {
  NEW_CLIENT_ASSIGNED
  PACKET_UPDATED
  PACKET_READY
}

model LawFirmNotificationSetting {
  id                   String                   @id @default(cuid())
  firmId               String
  firm                 LawFirm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  event                LawFirmNotificationEvent
  recipientEmails      String[]                 @default([])
  notifyPrimaryContact Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([firmId, event])
  @@index([firmId])
}

// Detailed notification scheduling/preferences for firms
model LawFirmNotificationSchedule {
  id     String  @id @default(cuid())
  firmId String  @unique
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  summaryEmailEnabled Boolean  @default(true)
  summaryEmailTimes   String[] @default(["06:00", "14:00"]) // HH:MM format
  timezone            String   @default("America/Denver")

  immediateNewClient   Boolean @default(true)
  immediatePacketReady Boolean @default(true)

  minimumActivities    Int     @default(1)
  suppressIfNoActivity Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

enum AttorneyActivityType {
  NEW_CLIENT_SIGNUP
  DOCUMENT_UPLOADED
  PACKET_GENERATED
  PACKET_DOWNLOADED
  CLAIMANT_RESPONDED
  MILESTONE_REACHED
  DOCUMENT_VALIDATED
  CONTACT_INFO_UPDATED
  FOLLOW_UP_COMPLETED
  SIGNIFICANT_PROGRESS
}

model AttorneyActivityLog {
  id         String         @id @default(cuid())
  firmId     String
  firm       LawFirm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    IntakeSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claimantId String?
  claimant   Claimant?      @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  activityType AttorneyActivityType
  title        String
  description  String?
